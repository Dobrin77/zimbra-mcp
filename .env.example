# Copy to .env and fill in. Secrets do NOT go here: they live in ./secrets/ (see deploy/INSTALL.md).

# Public address of this server (what users enter in Claude, without /mcp)
PUBLIC_URL=https://mcp.example.com
MCP_HOSTNAME=mcp.example.com
ACME_EMAIL=admin@example.com
ORG_NAME=Example
# Language of the web pages, error messages and Inbox notices: en (default) or bg (Bulgarian)
UI_LANG=en

# Zimbra SOAP endpoint, reached over the internal network
ZIMBRA_URL=https://mail.example.com/service/soap
# Set to false only if Zimbra uses a self-signed certificate; better: ZIMBRA_CA_FILE
ZIMBRA_VERIFY_TLS=true
#ZIMBRA_CA_FILE=/data/zimbra-ca.pem

# Zimbra LDAP, read-only account (password in ./secrets/ldap_password)
LDAP_URL=ldap://mail.example.com:389
LDAP_BIND_DN=uid=zmpostfix,cn=appaccts,cn=zimbra
LDAP_STARTTLS=true
LDAP_VERIFY_TLS=true
#LDAP_CA_FILE=/data/zimbra-ca.pem

# Who may open the passkey enrollment page: your office LAN(s) only, as narrow as possible
# (comma separated CIDRs). Do not list Docker's 172.16.0.0/12 range.
ENROLL_ALLOWED_NETWORKS=192.168.10.0/24
# Same list for Caddy, separated by spaces
ENROLL_ALLOWED_NETWORKS_CADDY=192.168.10.0/24
# Reverse proxies whose X-Real-IP header the app believes (comma separated CIDRs). The default
# covers Caddy on this machine, which reaches the container from Docker's bridge (172.16.0.0/12).
# Change it only if the proxy runs elsewhere.
#TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12

# Sending: false (default) = Claude only writes drafts, which the user sends from Zimbra.
# true = Claude may send mail after the user confirms the text in the chat
# (needed when Outlook uses POP3, which never shows server-side Drafts).
ZIMBRA_ENABLE_SEND=false
# Mail sent by Claude is never copied to the Sent folder (saves disk space); the sender
# gets a BCC copy in the Inbox instead. Recipients and subject are logged by this server.
# Keep false: mail deleted by Claude goes to Trash, never permanently.
ZIMBRA_ALLOW_HARD_DELETE=false
